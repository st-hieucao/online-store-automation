BASE_URL=https://dev.menu.starbucks.co.jp
BROWSER_CHANNEL=chrome
HEADLESS=true
IGNORE_HTTPS_ERRORS=false
CROSS_BROWSER=false
# off | on | retain-on-failure | on-first-retry — 'on' keeps a video for every test (pass or fail),
# useful as evidence for QA sign-off; default only keeps videos for failing tests.
VIDEO_MODE=retain-on-failure
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000

AUTH_LOGIN_URL=https://login2.starbucks.co.jp/login
AUTH_USERNAME=
AUTH_PASSWORD=

# Review function — optional; tests skip gracefully when not set
# Product in applicable category (tumblermug/goods/brewing) with ≥1 approved review
REVIEW_PRODUCT_CODE_WITH_REVIEWS=
# Product in applicable category with 0 approved reviews
REVIEW_PRODUCT_CODE_NO_REVIEWS=
# Full path to an existing review edit page, e.g. /4901111294993/review/abc123/edit
REVIEW_EDIT_PATH=

# HTTP Basic Auth popup shown by the browser on the partner pages (dev/stg server)
PARTNER_BASIC_USERNAME=
PARTNER_BASIC_PASSWORD=
